{
  "name": "annex",
  "version": "1.0.0",
  "description": "Offline, browser-only Android screen mirroring and control over WebUSB (scrcpy in a single HTML file).",
  "license": "MIT",
  "private": true,
  "keywords": ["android", "scrcpy", "webusb", "adb", "mirroring", "pwa", "offline"],
  "repository": { "type": "git", "url": "git+https://github.com/YOUR-USER/annex.git" },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "typecheck": "tsc -p . --noEmit",
    "test": "sh test/run.sh",
    "test:media": "sh test/make-media.sh"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/pcm-player": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "@yume-chan/struct": "^2.3.2"
  },
  "devDependencies": {
    "@types/w3c-web-usb": "^1.0.14",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.66.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "ws": "^8.22.1"
  }
}
